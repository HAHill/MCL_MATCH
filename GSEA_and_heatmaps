#Load packages
```{r}
library(ggplot2)
library(tidyverse)
library(DOSE)
library(readr)
library(cluster)
```
#import data

```{r}
Patient_1 <- read_delim("Desktop/MATCH/Normalized_Nanostring_Data/Patient_1/Patient 1_NormalizedData_No_Controls.gct.txt", 
    delim = "\t", escape_double = FALSE, 
    trim_ws = TRUE, skip = 2)
    View(Patient_1)
```

```{r}
GSEA <- gsea_report_for_Patient
```

```{r}
head(GSEA)
colnames(GSEA) [8] <- "FDR"
colnames(GSEA) [4] <- "Number_significant_genes"
colnames(GSEA) [1] <- "Pathway"

head(GSEA)
```
#filtered dataset

```{r}
library(dplyr)
GSEA_filtered <- subset(GSEA, NES >1)
GSEA_filtered <- arrange(GSEA_filtered, desc(NES))
```
#Plot Pathways, Weighted NES and FDR
```{r}

p <-ggplot(GSEA_filtered, aes(NES, Pathway))
p + geom_point(aes(colour=FDR, size=Number_significant_genes)) + scale_size_continuous(range=c(4,8))+
    scale_color_gradientn(colours=rainbow(3), limits=c(0, 0.5)) +
    geom_vline(xintercept=2, size=0.5, colour="gray50") +
    theme(panel.background=element_rect(fill="gray95", colour="gray95"),
          panel.grid.major=element_line(size=0.15,linetype='solid', colour="gray90"), 
          panel.grid.minor=element_line(size=0.15,linetype='solid', colour="gray90"),
          axis.title.y=element_blank()) +
    scale_x_continuous(breaks=c(1,1.5,2,2.5,3)) + 
    scale_y_discrete(limits=rev(GSEA_filtered$Pathway)) + labs(x="Weighted Normalized Enrichment Score (NES)", colour="FDR (q)", size= "Significant Genes Incuded")

ggsave("GSEA.pt1.weighted.png", width = 8, height = 10)
```
